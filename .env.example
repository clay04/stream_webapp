# Supabase (Project Settings → API). Pilih region Singapura (ap-southeast-1).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Bisa memakai NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (format baru sb_publishable_...) atau NEXT_PUBLIC_SUPABASE_ANON_KEY (JWT anon).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Rahasia! Hanya dipakai di server (Route Handler). Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Rahasia untuk Vercel Cron (Vercel otomatis mengirim header Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=ganti-dengan-string-acak-panjang

# Masa simpan room sementara (hari tanpa aktivitas).
TEMP_ROOM_TTL_DAYS=7

